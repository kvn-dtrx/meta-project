# ---
# title: Gitignore for Meta Project
# ---

# ---

# ---
# begin: .gitignore <- dia-project
# ---

# ---

# Base

# macOS
._*
.AppleDouble
.DS_Store
.LSOverride
.Spotlight-V100
.Trashes
Icon[[]]

# Linux
.nfs*
*~

# Windows
$RECYCLE.BIN/
Desktop.ini
ehthumbs.db
Thumbs.db

# Logs and temporary files
*.bak
*.bak[0-9]*
*.log
*.swo
*.swp
*.tmp
log/
logs/
tmp/
cache/

__pycache__/
*.py[cod]

# ---

# ---
# end: .gitignore <- dia-project
# ---
